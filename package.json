{
  "name": "crate_escape",
  "version": "1.0.0",
  "description": "A colorful isometric cargo-packing boat game",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
